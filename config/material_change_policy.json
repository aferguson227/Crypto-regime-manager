{
  "schema_version": "1.0",
  "application_version": "42.0.0",
  "volatile_keys": [
    "generated_at",
    "updated_at",
    "observed_at",
    "first_detected_at",
    "last_detected_at",
    "created_at",
    "closed_at"
  ],
  "profiles": {
    "health": {
      "paths": [
        ".github/workflows/*.yml",
        "docs/workflow_doctor.json",
        "docs/github_actions_health.json",
        "docs/operational_health.json",
        "docs/issues.json",
        "docs/self_healing_status.json",
        "docs/remediation_history.json",
        "docs/issue_lifecycle.json",
        "docs/engineering_health.json",
        "docs/release_readiness.json",
        "docs/synchronization_status.json"
      ],
      "exclude": [
        "docs/workflow_history.json",
        "docs/performance_history.json"
      ],
      "purpose": "Publish health evidence only when state or issue content materially changes; volatile timestamps alone do not create commits."
    },
    "local_agent": {
      "paths": [
        "docs/kucoin_account.json",
        "docs/capital_intelligence.json",
        "docs/operating_state.json",
        "docs/deployment_intelligence.json",
        "docs/recommendation_intelligence.json",
        "docs/portfolio_intelligence.json",
        "docs/cloud_reliability.json",
        "docs/operational_health.json",
        "docs/synchronization_status.json",
        "docs/decision_quality.json",
        "docs/engineering_health.json",
        "docs/command_state.json",
        "docs/professional_workspace.json",
        "docs/execution_provider_status.json",
        "docs/local_agent_status.json",
        "docs/research_evidence.json"
      ],
      "exclude": []
    }
  }
}
