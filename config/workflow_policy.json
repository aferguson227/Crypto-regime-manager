{
  "schema_version": "2.0",
  "application_version": "54.0.0",
  "workflows": {
    "data_refresh": {
      "path": ".github/workflows/crm-data-refresh.yml",
      "concurrency_group": "crm-data-refresh",
      "schedule": "37 * * * *",
      "may_write_contents": true,
      "may_deploy_pages": false,
      "required_modules": [
        "python -m scripts.threecommas_sync",
        "python -m scripts.cloud_update"
      ]
    },
    "pages": {
      "path": ".github/workflows/pages-deploy.yml",
      "concurrency_group": "crm-github-pages",
      "cancel_in_progress": false,
      "deploy_timeout_minutes": 30,
      "publish_path": "docs",
      "artifact_action": "actions/upload-pages-artifact@v4",
      "deploy_action": "actions/deploy-pages@v4"
    },
    "health_self_heal": {
      "path": ".github/workflows/crm-health-self-heal.yml",
      "concurrency_group": "crm-health-self-heal",
      "schedule": "17 */6 * * *",
      "may_write_contents": true,
      "may_deploy_pages": false
    },
    "release_validation": {
      "path": ".github/workflows/crm-release-validation.yml",
      "concurrency_group": "crm-release-validation",
      "manual_only": true,
      "may_write_contents": false,
      "may_deploy_pages": false
    }
  },
  "forbidden_legacy_workflows": [
    ".github/workflows/crm-self-heal.yml",
    ".github/workflows/engineering-audit.yml",
    ".github/workflows/multi-coin-update.yml",
    ".github/workflows/threecommas-update.yml"
  ],
  "guardrails": {
    "single_pages_publisher": true,
    "no_force_push": true,
    "no_secret_changes": true,
    "no_trading_mutations": true,
    "module_execution_required": true
  },
  "efficiency": {
    "health_material_change_only": true,
    "data_refresh_collects_actions_telemetry": true,
    "pages_live_version_verification": true,
    "health_does_not_publish_timestamp_only_evidence": true
  }
}
